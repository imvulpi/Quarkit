{
  "Id": "QkBrieflzExtractor",
  "Version": "1.0.0",
  "Dependencies": [],
  "CSources": [
    "brieflz-extractor.c",
    "deps/depack.c"
  ],
  "CompilerFlags": [
    "-DQUARKIT_QKBRIEFLZEXTRACTOR_MODULE"
  ],
  "PreBuildCommands": [
    {
      "Executable": "./<QkHostTriple>/blzpack.exe",
      "Arguments": "-9 <PayloadPath> <ScratchPath>/<PayloadName>.blz",
      "CaptureVariables": false,
      "ShorthandOverrides":{
        "<PayloadPath>": "<ScratchPath>/<PayloadName>.blz"
      }
    }
  ]
}